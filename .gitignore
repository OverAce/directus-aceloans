# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Dependencies / build output (used by extensions; safe defaults)
node_modules/
dist/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
.cache/

# Directus uploads (runtime media; keep dir, ignore contents)
uploads/*
!uploads/.gitkeep

# Claude Code per-machine local settings (MCP approvals, permission allow-list)
.claude/settings.local.json
