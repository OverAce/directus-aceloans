# ==============================================================================
# Directus Environment Configuration
# ==============================================================================
#
# Copy to:
#   .env.sentinel   — sentinel deployment (LAN-accessible staging)
#   .env.local     — MBP-local dev (overlay coming in a follow-up task)
#
# Format: KEY=value (no YAML colons, no quotes around values).
#
# Required vars are uncommented; optional/profile-specific vars are commented
# out and grouped below.
# ==============================================================================

# --- Directus Core ------------------------------------------------------------
KEY=replace-with-unique-key
SECRET=replace-with-unique-secret

# --- Admin Credentials --------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-your-password

# --- Public URL ---------------------------------------------------------------
# v12 production and the US mirror: https://data.kironhitel.hu
# Local dev default below is not that value.
# sentinel.local and the lab hostname are access paths, not PUBLIC_URL.
# See docs/specs/vulcan-sentinel-mirror.md.
# Must be an absolute URL before a Directus 12 license key is applied.
# Changing it later spends another Open Innovation Grant activation.
PUBLIC_URL=http://localhost:8055

# Open Innovation Grant key for Directus 12+. Per environment, never committed.
# LICENSE_KEY=

# --- Database -----------------------------------------------------------------
DB_CLIENT=pg
DB_SCHEMA=directus
# search_path: directus first so its system tables resolve at startup, then
# the rest of the schemas exposed to PostgREST.
DB_SEARCH_PATH=directus,public,extensions,events

# LOCAL profile (MBP): Supabase via `supabase start`
DB_HOST=host.docker.internal
DB_PORT=54322
DB_DATABASE=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# STAGING profile (sentinel): cloud Supabase project toyorzhdbqthqcnsdjgx
# Provision a dedicated DB user with access to the `directus` schema first
# (see README — Sentinel deployment).
# DB_HOST=db.your-project-ref.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USER=directus_app
# DB_PASSWORD=replace-with-staging-password
# DB_SSL__REJECT_UNAUTHORIZED=false

# --- Cache (Redis) ------------------------------------------------------------
CACHE_ENABLED=true
CACHE_STORE=redis
REDIS_HOST=aceloans-directus-cache
REDIS_PORT=6379

# --- Supabase Keys (staging only) --------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional -----------------------------------------------------------------
# LOG_LEVEL=info
# CORS_ENABLED=true
# CORS_ORIGIN=true
