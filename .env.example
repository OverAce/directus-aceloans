# ==============================================================================
# Directus Environment Configuration
# ==============================================================================
#
# Copy to .env.local (local dev) or .env.staging (staging hybrid):
#   cp .env.example .env.local
#   cp .env.example .env.staging
#
# ==============================================================================

# --- Directus Core ------------------------------------------------------------
KEY=replace-with-unique-key
SECRET=replace-with-unique-secret

# --- Admin Credentials --------------------------------------------------------
ADMIN_EMAIL=dev@marceldarvas.com
ADMIN_PASSWORD=replace-with-your-password

# --- Database -----------------------------------------------------------------
DB_CLIENT=pg
DB_SEARCH_PATH=directus,public,extensions

# LOCAL: Supabase via `supabase start`
DB_HOST=host.docker.internal
DB_PORT=54322
DB_DATABASE=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# STAGING: Remote Supabase (uncomment these, comment out LOCAL above)
# DB_HOST=db.your-project-ref.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USER=postgres
# DB_PASSWORD=your-remote-db-password
# DB_SSL__REJECT_UNAUTHORIZED=false

# --- Cache (Redis) ------------------------------------------------------------
CACHE_ENABLED=true
CACHE_STORE=redis
REDIS_HOST=aceloans-directus-cache
REDIS_PORT=6379

# --- Supabase Keys (staging only) --------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional -----------------------------------------------------------------
# PUBLIC_URL=http://localhost:8055
# LOG_LEVEL=info
# CORS_ENABLED=true
# CORS_ORIGIN=true
